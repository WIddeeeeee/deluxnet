{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "server=YOUR_SERVER_IP;database=redacted;user=redacted;password=redacted;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
  },
  "Steam": {
    "ApiKey": "Change to a valid steam id!"
  },
  "Public": {
    "BaseUrl": "https://localhost"
  },
  "Dns": {
    "Enabled": false,
    "Upstream": "8.8.8.8",
    "Records": {
      "rec.net": "auto"
    }
  },
  "Web": {
    "Hostnames": [ "rec.net" ]
  },
  "Load": {
    "Enabled": true,
    "MaxConcurrentRequests": 500,
    "GeneralRequestsPerMinute": 100,
    "AuthRequestsPerMinute": 10,
    "MaxRequestBodyBytes": 10485760,
    "SlowRequestThresholdSeconds": 2.0
  },
  "Volunteers": {
    "Enabled": true,
    "HeartbeatTimeoutSeconds": 180,
    "MaxServers": 200,
    "AllowPrivateHosts": false
  }
}
